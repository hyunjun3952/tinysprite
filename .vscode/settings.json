{
    // Run `cmake -S . -B build` once so clangd finds build/compile_commands.json.
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureOnOpen": false,
    // Editor diagnostics and formatting must match CI: clangd (with its built-in clang-tidy and
    // clang-format) is the major in scripts/clang-version, which scripts/install-deps.sh installs,
    // not the extension's own downloaded clangd.
    "clangd.path": "clangd-18",
    "clangd.checkUpdates": false,
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--background-index",
        "--header-insertion=never"
    ],
    // clangd does the language work; cpptools is only here for the debugger.
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "editor.tabSize": 4,
    "editor.rulers": [100],
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "files.exclude": {
        "**/.cache": true
    },
    "search.exclude": {
        "build": true,
        "thirdparty": true
    },
    "files.watcherExclude": {
        "**/build/**": true
    }
}
