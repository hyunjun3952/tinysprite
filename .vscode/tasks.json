{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake -S . -B build",
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cmake --build build -j",
            "dependsOn": "configure",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            "label": "test",
            "type": "shell",
            "command": "ctest --test-dir build --output-on-failure",
            "dependsOn": "build",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "format",
            "type": "shell",
            "command": "scripts/format.sh",
            "problemMatcher": []
        },
        {
            "label": "format check",
            "type": "shell",
            "command": "scripts/format.sh --check",
            "problemMatcher": []
        },
        {
            "label": "lint",
            "type": "shell",
            "command": "scripts/lint.sh",
            "dependsOn": "configure",
            "problemMatcher": "$gcc"
        }
    ]
}
