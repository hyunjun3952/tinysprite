{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "tinysprite",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/ui/tinysprite",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build",
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "test (pick a binary)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tests/${input:testBinary}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [{ "name": "SDL_VIDEODRIVER", "value": "dummy" }],
            "preLaunchTask": "build",
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ],
    "inputs": [
        {
            "id": "testBinary",
            "type": "promptString",
            "description": "Test binary under build/tests (e.g. test_history, test_ui_editor)",
            "default": "test_history"
        }
    ]
}
