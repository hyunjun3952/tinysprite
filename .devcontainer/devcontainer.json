{
    "name": "tinysprite",
    "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends libsdl2-dev pipx python3-venv && pipx install pre-commit && ~/.local/bin/pre-commit install && cmake -S . -B build",
    "customizations": {
        "vscode": {
            "extensions": ["llvm-vs-code-extensions.vscode-clangd"],
            "settings": {
                "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/build"],
                "[cpp]": {
                    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
                    "editor.formatOnSave": true
                }
            }
        }
    }
}
