{
    "name": "tinysprite",
    "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
    "postCreateCommand": "scripts/install-deps.sh && scripts/setup-hooks.sh",
    "customizations": {
        "vscode": {
            // The same tool versions as CI (scripts/clang-version), installed by install-deps.sh.
            "settings": {
                "clangd.path": "clangd-18",
                "clangd.checkUpdates": false,
                "clang-format.executable": "clang-format-18"
            },
            "extensions": [
                "ms-vscode.cmake-tools",
                "llvm-vs-code-extensions.vscode-clangd",
                "xaver.clang-format",
                "ms-vscode.cpptools",
                "timonwong.shellcheck"
            ]
        }
    }
}
